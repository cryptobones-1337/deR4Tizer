<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquet d'installation de deR4Tizer (WiX 3.14, licence MS-RL, sans redevance).
  Installe le service (compte SYSTEM, démarrage automatique, redémarré en cas d'échec) et l'interface,
  un raccourci dans le menu Démarrer et le lancement de l'interface à l'ouverture de session.

  Installation silencieuse (GPO, Intune, prestataire) :
    msiexec /i deR4Tizer.msi /qn
  Options :
    LANCEMENT_SESSION=0   ne pas lancer l'interface à l'ouverture de session
  Désinstallation (retire les blocages, règles de pare-feu, leurres, l'audit de lecture posé dans les profils, remet la
  baseline d'origine, efface les données ; le dossier C:\ProgramData\deR4Tizer reste, réservé à SYSTEM et aux
  administrateurs, vide ou avec la seule quarantaine si elle n'est pas vide) :
    msiexec /x deR4Tizer.msi /qn [GARDER_DONNEES=1] [GARDER_BASELINE=1]
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="deR4Tizer" Language="1036" Codepage="1252" Version="$(var.Version)" Manufacturer="deR4Tizer (projet open source)"
           UpgradeCode="6F1E2B47-9C3A-4D58-8E21-4B7D0C9A3F15">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="deR4Tizer : surveillance, alertes et durcissement locaux pour Windows" Comments="Licence EUPL-1.2" />

    <!-- Retour arrière de la mise à jour automatique : le service réinstalle le paquet de la version précédente
         (le contrôle « version plus récente » est fait par le service avant d'installer) -->
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="LANCEMENT_SESSION" Value="1" />
    <!-- Choix installé, relu à chaque mise à niveau et réparation : LANCEMENT_SESSION n'est pas mémorisé, et maj.rs lance msiexec
         sans le repasser. Sans valeur Run installée, le lancement reste refusé (relecture de #101, D1) -->
    <Property Id="LANCEMENT_INSTALLE">
      <RegistrySearch Id="ChercherLancement" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="deR4Tizer" Type="raw" Win64="yes" />
    </Property>
    <SetProperty Id="LANCEMENT_SESSION" Value="0" Before="CostInitialize" Sequence="execute"><![CDATA[(WIX_UPGRADE_DETECTED OR Installed) AND NOT LANCEMENT_INSTALLE]]></SetProperty>
    <!-- Dernière page (U8a, dossier de conception U8) : un texte, jamais de case « Lancer deR4Tizer » ni d'action qui lance un
         programme. L'interface est démarrée par la tâche de relance, sans élévation ; lancée d'ici, elle pourrait tourner
         élevée et garder le mutex de la session. Affectations de propriété côté client (type 51) : aucun code exécuté.
         Langue d'après UserLanguageID (français pour les identifiants français, anglais sinon) ; lancement effectif : miroir
         exact de la condition de la séquence d'exécution (SetProperty LANCEMENT_SESSION ci-dessus), qui ne revient pas à
         l'interface du MSI -->
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Action="TexteFinFrLance" After="AppSearch" Sequence="ui" Value="Le service deR4Tizer est installé (démarrage automatique). L'interface démarrera d'elle-même sous votre compte dans les minutes qui suivent, avec son icône près de l'horloge, puis à chaque ouverture de session. Cette page ne la lance pas."><![CDATA[(UserLanguageID=1036 OR UserLanguageID=2060 OR UserLanguageID=3084 OR UserLanguageID=4108 OR UserLanguageID=5132 OR UserLanguageID=6156) AND LANCEMENT_SESSION="1" AND NOT ((WIX_UPGRADE_DETECTED OR Installed) AND NOT LANCEMENT_INSTALLE)]]></SetProperty>
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Action="TexteFinFrSans" After="TexteFinFrLance" Sequence="ui" Value="Le service deR4Tizer est installé (démarrage automatique). Sur ce poste, l'interface ne démarre pas d'elle-même (option LANCEMENT_SESSION=0) : ouvrez-la depuis le menu Démarrer."><![CDATA[(UserLanguageID=1036 OR UserLanguageID=2060 OR UserLanguageID=3084 OR UserLanguageID=4108 OR UserLanguageID=5132 OR UserLanguageID=6156) AND NOT (LANCEMENT_SESSION="1" AND NOT ((WIX_UPGRADE_DETECTED OR Installed) AND NOT LANCEMENT_INSTALLE))]]></SetProperty>
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Action="TexteFinEnLance" After="TexteFinFrSans" Sequence="ui" Value="The deR4Tizer service is installed (automatic start). The interface will start on its own under your account within the next few minutes, with its icon near the clock, then at every sign-in. This page does not start it."><![CDATA[NOT (UserLanguageID=1036 OR UserLanguageID=2060 OR UserLanguageID=3084 OR UserLanguageID=4108 OR UserLanguageID=5132 OR UserLanguageID=6156) AND LANCEMENT_SESSION="1" AND NOT ((WIX_UPGRADE_DETECTED OR Installed) AND NOT LANCEMENT_INSTALLE)]]></SetProperty>
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Action="TexteFinEnSans" After="TexteFinEnLance" Sequence="ui" Value="The deR4Tizer service is installed (automatic start). On this computer the interface does not start on its own (LANCEMENT_SESSION=0 option): open it from the Start menu."><![CDATA[NOT (UserLanguageID=1036 OR UserLanguageID=2060 OR UserLanguageID=3084 OR UserLanguageID=4108 OR UserLanguageID=5132 OR UserLanguageID=6156) AND NOT (LANCEMENT_SESSION="1" AND NOT ((WIX_UPGRADE_DETECTED OR Installed) AND NOT LANCEMENT_INSTALLE))]]></SetProperty>
    <Property Id="GARDER_DONNEES" Secure="yes" />
    <Property Id="GARDER_BASELINE" Secure="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cryptobones-1337/deR4Tizer" />
    <Property Id="ARPPRODUCTICON" Value="icone.exe" />
    <!-- Pas de réparation depuis « Applications » (WixUI_Minimal retire déjà « Modifier ») : une réparation arrête et relance le service -->
    <Property Id="ARPNOREPAIR" Value="1" />
    <Icon Id="icone.exe" SourceFile="$(var.Bin)\deR4Tizer.exe" />

    <Condition Message="deR4Tizer nécessite Windows 10 ou plus récent, en 64 bits.">
      <![CDATA[Installed OR (VersionNT64 >= 603)]]>
    </Condition>
    <!-- Réparation (msiexec /fa) par un compte standard : refusée, elle arrêterait la surveillance -->
    <Condition Message="La réparation de deR4Tizer est réservée aux administrateurs.">
      <![CDATA[NOT Installed OR REMOVE="ALL" OR UPGRADINGPRODUCTCODE OR AdminUser]]>
    </Condition>
    <!-- Dossier de données point d'analyse (jonction, lien symbolique, audit du 2026-11-23, C-1) : installation, mise à niveau
         et réparation refusées. Un compte standard peut poser C:\ProgramData\deR4Tizer comme jonction vers un dossier à lui ;
         le service, lui, n'écrit plus dessous (protection.rs), mais ne surveillerait pas. Échec fermé : seule la valeur « ok »
         lue par l'action LireDossierDonnees laisse passer ; la désinstallation n'est jamais bloquée -->
    <Condition Message="Le dossier de données [CommonAppDataFolder]deR4Tizer est un lien (jonction, lien symbolique) ou n'a pas pu être vérifié : installation refusée. Supprimez ce lien en administrateur, puis relancez l'installation.">
      <![CDATA[REMOVE="ALL" OR DonneesEtat="ok"]]>
    </Condition>
    <!-- Lecture seule des attributs du dossier de données, sans rien écrire : fonction JScript (installeur\lire-dossier-donnees.js,
         table Binary), immédiate, dans les deux séquences avant les conditions de lancement. WiX 3 n'a aucune recherche qui lise l'attribut « point d'analyse »
         (AppSearch ne voit qu'un dossier présent ou absent) ; une action en script évite d'ajouter une DLL ou un second
         exécutable au paquet. Script indisponible ou en erreur : l'action échoue (Return="check") ou la valeur reste
         « inconnu », et l'installation est refusée -->
    <Binary Id="ScriptDossierDonnees" SourceFile="$(var.Installeur)\lire-dossier-donnees.js" />
    <CustomAction Id="LireDossierDonnees" BinaryKey="ScriptDossierDonnees" JScriptCall="LireDossierDonnees" Return="check" />
    <InstallUISequence>
      <Custom Action="LireDossierDonnees" Before="LaunchConditions" />
    </InstallUISequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="deR4Tizer" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DONNEES" Name="deR4Tizer" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Service" Guid="3C8A51D2-7E44-4B0A-9F6B-2D1E8C7A5B90" Win64="yes">
        <File Id="ServiceExe" Name="deR4TizerSvc.exe" Source="$(var.Bin)\deR4TizerSvc.exe" KeyPath="yes" />
        <ServiceInstall Id="InstallationService" Name="deR4Tizer" DisplayName="deR4Tizer" Type="ownProcess" Start="auto"
                        Account="LocalSystem" ErrorControl="normal"
                        Description="Surveille les connexions, la persistance et le réseau local, alerte et applique les blocages.">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ControleService" Name="deR4Tizer" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="Interface" Guid="A4F07C19-2B6D-4E83-8D5A-91C3E6B2F048" Win64="yes">
        <File Id="InterfaceExe" Name="deR4Tizer.exe" Source="$(var.Bin)\deR4Tizer.exe" KeyPath="yes">
          <Shortcut Id="RaccourciMenu" Directory="ProgramMenuFolder" Name="deR4Tizer" Advertise="yes" WorkingDirectory="INSTALLFOLDER"
                    Icon="icone.exe" Description="Surveillance locale : connexions, alertes, réseau local" />
        </File>
      </Component>
      <!-- Droits du dossier des programmes posés par le paquet (audit du 2026-11-23, A-4-1) : INSTALLFOLDER est une
           propriété publique, redirigeable vers un dossier qu'un compte standard peut écrire (une DLL ou un programme posé
           là serait exécuté en SYSTEM). SYSTEM et administrateurs en contrôle total, Utilisateurs en lecture et
           exécution, propriétaire Administrateurs, héritage coupé ; le service les relit au démarrage (protection.rs,
           INT-003) et refuse la mise à jour automatique s'ils ont changé -->
      <Component Id="DossierProgrammes" Guid="5B8E2F14-9C6A-4D37-A1E0-3F7B6C9D2E85" Win64="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>
      <Component Id="LancementSession" Guid="E2B96D40-5A71-4C1F-B3E8-7D0A4F2C6E19" Win64="yes">
        <Condition>LANCEMENT_SESSION = "1"</Condition>
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="deR4Tizer" Type="string"
                       Value="&quot;[INSTALLFOLDER]deR4Tizer.exe&quot; --cache" KeyPath="yes" />
      </Component>
    </DirectoryRef>


    <!-- Dossier de données créé avec ses droits (SYSTEM et administrateurs, propriétaire Administrateurs, sans
         héritage de ProgramData où les utilisateurs peuvent créer des fichiers). Le service les impose aussi à
         chaque démarrage (protection.rs), et ajoute la lecture pour les comptes autorisés. Permanent (lot A, point 4) :
         la désinstallation ne retire pas ce dossier ; l'action SupprimerDonnees le vide et le garde protégé, pour qu'un compte
         standard ne puisse pas y poser une jonction avant une réinstallation. Une quarantaine non vide y reste, réservée à
         SYSTEM et aux administrateurs (audit du 2026-11-23, A-4-3) -->
    <DirectoryRef Id="DONNEES">
      <Component Id="Donnees" Guid="7D2C4A91-3E5B-4F68-A0C7-5B9E1D8F2A63" Win64="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <Feature Id="Principal" Title="deR4Tizer" Level="1">
      <ComponentRef Id="Service" />
      <ComponentRef Id="Interface" />
      <ComponentRef Id="DossierProgrammes" />
      <ComponentRef Id="LancementSession" />
      <ComponentRef Id="Donnees" />
    </Feature>

    <!-- Désinstallation (pas lors d'une mise à jour) : le service arrêté, on retire ce qu'il a posé, avant d'effacer les fichiers -->
    <!-- Relance de l'interface (D4-1, option C) : tâche planifiée posée en SYSTEM, lancée par Windows sous l'identité de chaque
         utilisateur connecté, sans élévation ; retirée à la désinstallation (Nettoyer) ou avec LANCEMENT_SESSION=0 -->
    <CustomAction Id="SuspendreRelance" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Change /TN &quot;deR4Tizer Relance interface&quot; /DISABLE" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="PoserRelance" FileKey="ServiceExe" ExeCommand="--poser-relance" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RetirerRelance" FileKey="ServiceExe" ExeCommand="--retirer-relance" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="Nettoyer" FileKey="ServiceExe" ExeCommand="--nettoyer" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="AnnulerBaseline" FileKey="ServiceExe" ExeCommand="--annuler-baseline" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SupprimerDonnees" FileKey="ServiceExe" ExeCommand="--supprimer-donnees" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="FermerInterface" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /F /IM deR4Tizer.exe" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="LireDossierDonnees" Before="LaunchConditions" />
      <Custom Action="PoserRelance" After="InstallFiles"><![CDATA[NOT REMOVE="ALL" AND LANCEMENT_SESSION="1"]]></Custom>
      <Custom Action="RetirerRelance" After="PoserRelance"><![CDATA[NOT REMOVE="ALL" AND LANCEMENT_SESSION<>"1"]]></Custom>
      <Custom Action="SuspendreRelance" Before="FermerInterface">REMOVE OR UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="FermerInterface" Before="StopServices">REMOVE OR UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="Nettoyer" After="StopServices"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Custom>
      <Custom Action="AnnulerBaseline" After="Nettoyer"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND GARDER_BASELINE<>"1"]]></Custom>
      <Custom Action="SupprimerDonnees" After="AnnulerBaseline"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND GARDER_DONNEES<>"1"]]></Custom>
    </InstallExecuteSequence>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Installeur)\licence.rtf" />
  </Product>
</Wix>
